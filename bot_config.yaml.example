# Telegram bot configuration
# Copy this file to bot_config.yaml and fill in your values

# -----------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------

# Get your token from @BotFather on Telegram
telegram_bot_token: "YOUR_TELEGRAM_BOT_TOKEN_HERE"

# Optional: restrict bot to specific Telegram user IDs.
# Leave empty (or remove) to allow everyone.
# Find your ID by messaging @userinfobot on Telegram.
allowed_user_ids: []
# allowed_user_ids:
#   - 123456789
#   - 987654321

# -----------------------------------------------------------------------
# Plan generation service (Plan API)
# -----------------------------------------------------------------------
# The bot no longer talks to an LLM directly -- it calls a running instance
# of the FitWeaver Plan API (src/garmin_fit/api/, started with
# `garmin-fit-api` after `pip install -e ".[api]"`), which is the same
# service the GUI's "LLM автора" mode uses. This can be the same machine
# (http://127.0.0.1:8008 if you followed api_config.yaml.example's default
# port) or a remote host running the API.

plan_api_url: "http://127.0.0.1:8008"
plan_api_token: "MUST_MATCH_api_config.yaml's_api_token"

# -----------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------

# Seconds of inactivity before a user's session resets and /start is
# required again (also applies if a user never picked a language via /start
# and sends plan text directly, e.g. a second phone). Default: 1200 (20 min)
# session_timeout_sec: 1200

# -----------------------------------------------------------------------
# Garmin Connect (optional — enables /connect_garmin and /send_to_garmin)
# -----------------------------------------------------------------------
# Credentials are entered interactively via /connect_garmin in the bot.
# No need to store them here. Tokens are cached per user after first login.
#
# To pre-set credentials for a single-user setup (optional):
# garmin_email: "your@email.com"
# garmin_password: "yourpassword"
